<!DOCTYPE html>
<html>
  <head>
    <title>Quiizz</title>
    
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <style>
    
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }
      
      .header {
        border-bottom: 1px solid;
        padding: 1rem 0;
        margin-bottom: 2rem;
      }
      
      .header-content {
        display: flex;
        justify-content: space-between;
      }
      
      .logo {
        font-size: 1.8rem;
        color: #800080;
        text-decoration: none;
      }

      .logo-link:hover{
        color: #8A2BE2;
      }
      
      .nav {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      
      .nav-link {
        color: #800080;
        text-decoration: none;
        padding: 0.5rem 0;
        transition: color 0.2s;
      }
      
      .nav-link:hover {
        color: #8A2BE2;
      }
      
      .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #DDA0DD;
        color: #FFFFFF;
        text-decoration: none;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        transition: background 0.2s;
      }
      
      .btn:hover {
        background: #D8BFD8;
      }

      .hidden {
        display: none !important;
      }
      
      .btn-outline {
        background: transparent;
        color: #555;
        border: 1px solid #ddd;
      }
      
      .btn-outline:hover {
        background: #f5f5f5;
      }
      
      .main-content {
        background: #FFFFFF;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container header-content">
        <%= link_to "Quiizz", root_path, class: "logo" %>
        
        <nav class="nav">
          <% if logged_in? %>
            <%= link_to "Все квизы", quizzes_path, class: "nav-link" %>
            <%= link_to "Личный кабинет", profile_path, class: "nav-link" %>
            <%= button_to "Выйти", logout_path, method: :delete, class: "btn btn-outline", form: { style: "display: inline;" } %>
          <% else %>
            <%= link_to "Войти", login_path, class: "nav-link" %>
            <%= link_to "Регистрация", register_path, class: "btn" %>
          <% end %>
        </nav>
      </div>
    </header>

    <div class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>">
          <%= message %>
        </div>
      <% end %>

      <main class="main-content">
        <%= yield %>
      </main>
    </div>
  </body>
</html>