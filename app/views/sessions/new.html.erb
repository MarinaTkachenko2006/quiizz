<h1>Вход в систему</h1>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Пароль" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "Войти" %>
  </div>
<% end %>

<p>Нет аккаунта? <%= link_to "Зарегистрироваться", register_path %></p>