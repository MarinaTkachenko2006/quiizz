<div style="max-width: 500px; margin: 0 auto;">
  <h1 style="margin-bottom: 1.5rem; color: #333; text-align: center">Вход в аккаунт</h1>
  
  <%= form_with url: login_path do |form| %>
    <% if flash[:alert] %>
      <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :email, "Почта", class: "form-label" %>
      <%= form.email_field :email, class: "form-control", value: params[:email] %>
    </div>

    <div class="form-group">
      <%= form.label :password, "Пароль", class: "form-label" %>
      <%= form.password_field :password, class: "form-control" %>
    </div>

    <div style="margin-top: 2rem; text-align: center">
      <%= form.submit "Войти", class: "btn" %>
    </div>
  <% end %>
</div>