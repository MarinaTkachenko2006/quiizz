<div class="border border-gray-200 rounded-lg p-4 question-item" data-question-index="<%= f.index %>">
  <div class="flex justify-between items-start mb-4">
    <h3 class="text-lg font-medium text-gray-900">Question</h3>
    <button type="button" 
            onclick="removeQuestion(this)"
            class="text-red-600 hover:text-red-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="space-y-4">
    <div>
      <%= f.label :text, "Question *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :text, 
                      rows: 3,
                      class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500",
                      required: true,
                      placeholder: "Enter question..." %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= f.label :order_index, "Order", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :order_index, 
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md",
                           min: 1,
                           value: f.object.order_index || 1 %>
      </div>
      
      <div>
        <%= f.label :reward, "Score", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :reward, 
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md",
                           min: 0,
                           value: f.object.reward || 10 %>
      </div>
      
      <div>
        <%= f.label :time_limit, "Time (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :time_limit, 
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md",
                           min: 1,
                           value: f.object.time_limit || 30 %>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <div class="flex justify-between items-center mb-4">
      <h4 class="text-md font-medium text-gray-700">Answers</h4>
      <button type="button" 
              class="inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
              onclick="addAnswer(this)">
        + Add answer
      </button>
    </div>

    <div class="space-y-3 answers-container">
      <%= f.fields_for :answers do |answer_fields| %>
        <div class="flex items-center gap-3 answer-item">
          <div class="flex-grow">
            <%= answer_fields.text_field :answer_text, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500",
                  required: true,
                  placeholder: "Answer option..." %>
          </div>

          <div class="flex items-center">
            <%= answer_fields.check_box :is_correct, class: "h-5 w-5 text-emerald-600 border-gray-300 rounded" %>
            <%= answer_fields.label :is_correct, "Is correct", class: "ml-2 text-sm text-gray-700" %>
          </div>

          <button type="button" 
                  onclick="removeAnswer(this)"
                  class="text-red-600 hover:text-red-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>