<div id="quiz-container" class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    
    <!--Сообщение о повторном прохождении-->
    <% if @already_completed && !is_author %>
      <div class="flash flash-notice" style="margin-bottom: 2rem;">
        <div class="flex items-center">
          <div class="ml-4">
            <h3 style="font-size: 1.1rem; font-weight: 600; color: #2c5282; margin: 0 0 0.5rem 0;">Вы уже проходили этот квиз</h3>
            <div style="margin-top: 0.5rem; color: #4a5568;">
              <p style="margin: 0;">Ваш результат: <%= @score %> очков, <%= @correct_answers %> правильных ответов (<%= @accuracy %>% точности)</p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    
    <div id="quiz-header" class="bg-white rounded-2xl shadow-lg p-6 mb-8">
      <div style="display: flex; justify-content: space-between; align-items: flex-start">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @quiz.title %></h1>
          <% if @quiz.description.present? %>
            <p class="text-gray-600"><%= @quiz.description %></p>
          <% end %>
        </div>
        
        <div id="quiz-code" class="bg-gray-100 px-4 py-2 rounded-lg">
          <div class="text-sm text-gray-500">Код квиза: <%= @quiz.id %></div>
        </div>
      </div>
    
    <!--Экран ожидания-->
    <div id="waiting-screen" class="text-center py-16">
      <div class="bg-white rounded-2xl shadow-lg p-8 max-w-md mx-auto">
        <div class="mb-8">
          <p class="text-gray-600 mb-6" id="waiting-message">
            <% if is_author %>Дождитесь подключения участников и запустите квиз<% end %>
          </p>
          <% if !is_author && !@already_completed %>
            <div class="text-sm text-gray-500">Вы присоединились к квизу. Ожидайте начала.</div>
          <% end %>
          <div id="participants-count" class="text-lg font-semibold text-purple-600 mb-2">Участников: <span id="participants-count-number">1</span></div>
        </div>
        
        <% if is_author && !@already_completed %>
          <button id="start-quiz-btn" 
                  onclick="startQuiz()"
                  class="px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-medium transition disabled:opacity-50 disabled:cursor-not-allowed">Начать квиз</button>
        <% end %>
        
      </div>
    </div>
    
     <!-- Управление квизом-->
    <div id="quiz-management-container" class="hidden" style="margin-bottom: 1.5rem;">
      <div style="padding: 1.5rem; background: #f8f8f8; border-radius: 8px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
          <h3 style="font-size: 1.1rem; font-weight: 600; color: #444;">Управление квизом</h3>
          <div style="display: flex; gap: 0.75rem;">
            <button type="button" 
                    id="pause-quiz-btn" 
                    onclick="togglePause()"
                    style="padding: 0.5rem 1rem; background: #4299e1; color: white; border: none; border-radius: 6px; font-size: 0.9rem; cursor: pointer; transition: background 0.2s;">
              <span id="pause-text">Пауза</span>
            </button>
                    
            <button type="button" 
                    id="next-question-btn" 
                    onclick="nextQuestion()"
                    style="padding: 0.5rem 1rem; background: #38a169; color: white; border: none; border-radius: 6px; font-size: 0.9rem; cursor: pointer; transition: background 0.2s;">
              Следующий вопрос
            </button>
          </div>
        </div>
                
        <div style="font-size: 0.9rem; color: #666;">
          <div id="pause-status" class="hidden" style="margin-bottom: 0.25rem;">
            <span style="display: inline-flex; align-items: center;">
              Квиз на паузе
            </span>
          </div>
          <div>
            Текущий вопрос: <span id="author-current-question">-</span> из <%= @questions.count %>
          </div>
        </div>
      </div>
    </div>

    <div id="questions-container" class="hidden">
    </div>
    <div id="results-container" class="hidden">
    </div>
  </div>
</div>

<%= action_cable_meta_tag %>
<!-- Action Cable через CDN -->
<script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.2/app/assets/javascripts/actioncable.js"></script>

<script>
window.quizId = '<%= @quiz.id %>';
let quizChannel = null;
let currentQuestion = 1;
let totalQuestions = <%= @questions.count %>;
let participants = [];
let questionTimer = null;
let timeLeft = 0;

document.addEventListener('DOMContentLoaded', function() {
  const cableUrl = window.CABLE_URL || '/cable';
  window.App = { cable: ActionCable.createConsumer(cableUrl) };
  
  // Подключаемся к каналу
  quizChannel = App.cable.subscriptions.create({
    channel: 'QuizChannel',
    quiz_id: '<%= @quiz.id %>'
  }, {
      received: function(data) {
      handleMessage(data);
    }
  });
  
  window.quizChannel = quizChannel;
});

function handleMessage(data) {  
  switch(data.action) {
    case 'state_update':      
      updateParticipants(data.participants || []);
      break;
      
    case 'quiz_started':
      window.quizQuestions = data.questions;
      window.totalQuestions = data.total_questions;
      showQuizStarted();
      if (<%= is_author %>)
        showAuthorControls();
      break;
      
    case 'next_question':     
      window.currentQuestion = data.question_number;
      showQuestion(data.question, data.question_number, data.total_questions);
      break;
      
    case 'quiz_paused':
      updatePauseState(true);
      pauseTimer();
      break;
      
    case 'quiz_resumed':
      updatePauseState(false);
      resumeTimer(); 
      break;
      
    case 'quiz_ended':
      stopTimer();
      showResults(data.statistics);
      break;
  }

}
function startQuiz() {
  
  if (!<%= is_author %>)
    return;
  
  if (!window.quizChannel){
    alert('No connetction to the quiz');
    return;
  }
  
  window.quizChannel.perform('start_quiz', {
    timestamp: new Date().toISOString(),
    user_id: <%= current_user.id %>});
}

function startTimer(seconds) {
  stopTimer(); // Останавливаем предыдущий таймер
  timeLeft = seconds;
  
  const timerElement = document.getElementById('timer');
  if (!timerElement) return;
  
  timerElement.textContent = formatTime(timeLeft);
  
  questionTimer = setInterval(() => {
    timeLeft--;
    timerElement.textContent = formatTime(timeLeft);
    
    if (timeLeft <= 0) {
      stopTimer();
      // Время вышло, автоматически блокируем ответы для участников
      if (<%= !is_author %>) {
        document.querySelectorAll('.answer-btn').forEach(btn => {
          btn.disabled = true;
          btn.classList.add('opacity-50', 'cursor-not-allowed');
        });
      }
    }
    
    // Визуальная индикация при малом времени
    if (timeLeft <= 5) {
      timerElement.classList.add('text-red-600', 'font-bold');
    } else {
      timerElement.classList.remove('text-red-600', 'font-bold');
    }
  }, 1000);
}

function formatTime(seconds) {
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
}

function stopTimer() {
  if (questionTimer) {
    clearInterval(questionTimer);
    questionTimer = null;
  }
}

function pauseTimer() {
  if (questionTimer) {
    clearInterval(questionTimer);
    questionTimer = null;
  }
}

function resumeTimer() {
  if (timeLeft > 0) {
    startTimer(timeLeft);
  }
}


function updateParticipants(participantsList) {
  const count = document.getElementById('participants-count-number');
  const list = document.getElementById('participants-list');
  const container = document.getElementById('participants-container');
  
  if (count)
    count.textContent = participantsList.length;
  
  if (list) {
    list.innerHTML = '';
    
    participantsList.forEach(p => {
      const div = document.createElement('div');
      div.className = 'flex items-center bg-gray-100 px-3 py-1 rounded-full';
      div.innerHTML = `
        <div class="w-2 h-2 ${p.is_author ? 'bg-purple-500' : 'bg-green-500'} rounded-full mr-2"></div>
        <span class="text-sm">${p.nickname}</span>`;
      list.appendChild(div);
    });
  }
  
  if (container) {
    if (participantsList.length > 1) container.classList.remove('hidden');
    else container.classList.add('hidden');
  }

}


function nextQuestion() {
  if (!<%= is_author %>) return;
  
  window.quizChannel.perform('next_question', {
    timestamp: new Date().toISOString(),
    user_id: <%= current_user.id %>
  });

}
function togglePause() {
  if (!<%= is_author %>) return;
  
  const isPaused = document.getElementById('pause-text').textContent === 'Продолжить';
  
  window.quizChannel.perform('pause_quiz', {
    paused: !isPaused,
    timestamp: new Date().toISOString(),
    user_id: <%= current_user.id %>
  });
}

function selectAnswer(answerId, questionId) {
  if (<%= is_author %>) return;
  document.querySelectorAll('.answer-btn').forEach(btn => { btn.disabled = true; });
  
  stopTimer();
  document.querySelectorAll('.answer-btn').forEach(btn => {
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');
  });

  
  window.quizChannel.perform('submit_answer', {
    question_id: questionId,
    answer_id: answerId,
    timestamp: new Date().toISOString(),
    user_id: <%= current_user.id %>});

}
function showQuizStarted() {
  document.getElementById('waiting-screen').classList.add('hidden');
  document.getElementById('questions-container').classList.remove('hidden');
  if (window.quizQuestions && window.quizQuestions.length > 0) {
    setTimeout(() => {
      if (<%= is_author %>) nextQuestion();
    }, 1000);
  }
}

function showQuestion(questionData, questionNumber, total) {
  const container = document.getElementById('questions-container');
  
  const answersHtml = questionData.answers.map((answer, index) => `
    <button type="button" 
            onclick="selectAnswer(${answer.id}, ${questionData.id})"
            class="answer-btn w-full text-left p-4 bg-white border border-gray-200 rounded-lg hover:border-purple-300 hover:shadow-sm transition mb-3">
      <div class="text-gray-800">${answer.answer_text}</div>
    </button>`).join('');

  container.innerHTML = `
    <div class="main-content">
      <div class="mb-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <div class="flex items-center mb-2">
              <div class="text-sm text-gray-600">
                Вопрос ${questionNumber} из ${total} & ${questionData.reward} баллов
              </div>
            </div>
            <h2 class="text-xl font-bold text-gray-900">${questionData.text}</h2>
          </div>
          
          <div class="bg-gray-100 px-4 py-2 rounded">
            <span id="timer" class="text-lg font-bold text-gray-900">${formatTime(questionData.time_limit)}</span>
          </div>
        </div>
      </div>

      <div>
        ${answersHtml}
      </div>
      
      <!-- Статус -->
      <div class="mt-6 pt-6 border-t border-gray-200 text-center">
        <div class="text-sm text-gray-500">
          ${<%= is_author %> ? 
            'Участники отвечают' : 
            'Выберите вариант ответа'
          }
        </div>
      </div>
    </div>`;
  
  startTimer(questionData.time_limit);
  
  if (<%= is_author %>)
    document.getElementById('author-current-question').textContent = questionNumber;
}


function showResults(statistics) {
  document.getElementById('questions-container').classList.add('hidden');
  document.getElementById('quiz-management-container').classList.add('hidden');
  document.getElementById('results-container').classList.remove('hidden');
  
  const container = document.getElementById('results-container');
  
  const sortedStats = [...statistics].sort((a, b) => {
    const aPercentage = (a.correct_answers / a.total_questions) * 100;
    const bPercentage = (b.correct_answers / b.total_questions) * 100;
    return bPercentage - aPercentage;
  });
  
  const top5 = sortedStats.slice(0, 5);
  
  let html = `
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Квиз завершен!</h2>
      
      <div class="text-center mb-8">
        <div class="text-lg font-medium text-gray-700 mb-2">Топ-5 участников</div>
      </div>
      
      <div class="space-y-4">`;
  
  if (top5.length === 0) {
    html += `
      <div class="text-center py-8 text-gray-500">
        Нет данных о результатах
      </div>`;
  } else {
    top5.forEach((stat, index) => {
      const isCurrentUser = stat.user_id == <%= current_user.id %>;
      const percentage = stat.total_questions > 0 ? 
        Math.round((stat.correct_answers / stat.total_questions) * 100) : 0;
      const position = index + 1;
      
      html += `
        <div class="p-4 rounded-lg border ${isCurrentUser ? 'bg-purple-50 border-purple-200' : 'bg-gray-50 border-gray-200'}">
          <div class="flex items-center justify-between">
            <div>
              <div class="font-semibold ${isCurrentUser ? 'text-purple-700' : 'text-gray-700'}">
                ${position}. ${stat.nickname} ${isCurrentUser ? '(Вы)' : ''} - ${stat.correct_answers} из ${stat.total_questions} правильных (${percentage}%)
              </div>
            </div>
          </div>
        </div>
      `;
    });
  }
  
  html += `
      </div>
      
      <div class="mt-8 pt-6 border-t border-gray-200 text-center">
        <div class="text-sm text-gray-500">
          Всего участников: ${statistics.length}
        </div>
      </div>
    </div>`;
  
  container.innerHTML = html;
}

function updatePauseState(isPaused) {
  const btn = document.getElementById('pause-quiz-btn');
  const text = document.getElementById('pause-text');
  const status = document.getElementById('pause-status');
  
  if (!btn || !text || !status) return;
  
  if (isPaused) {
    text.textContent = 'Продолжить';
    status.classList.remove('hidden');
    btn.classList.remove('bg-blue-500');
    btn.classList.add('bg-yellow-500');
    
    if (<%= !is_author %>) {
      const questionsContainer = document.getElementById('questions-container');
      if (questionsContainer) {
        const pauseMessage = document.createElement('div');
        pauseMessage.className = 'bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-4 text-center';
        pauseMessage.innerHTML = `
          <div class="flex items-center justify-center">
            <span class="text-yellow-800 font-medium">Квиз на паузе. Ожидайте продолжения</span>
          </div>
        `;
        questionsContainer.prepend(pauseMessage);
      }
    }
  } else {
    text.textContent = 'Пауза';
    status.classList.add('hidden');
    btn.classList.remove('bg-yellow-500');
    btn.classList.add('bg-blue-500');
    
    if (<%= !is_author %>) {
      const pauseMessage = document.querySelector('.bg-yellow-50.border-yellow-200');
      if (pauseMessage)
        pauseMessage.remove();
    }
  }
}

function updateStatus(status) {
  const el = document.getElementById('connection-status');
  if (el) {
    el.textContent = status === 'connected' ? 'ПОДКЛЮЧЕН' : 'ОТКЛЮЧЕН';
    el.className = status === 'connected' 
      ? 'px-2 py-1 text-xs rounded bg-green-100 text-green-800' 
      : 'px-2 py-1 text-xs rounded bg-red-100 text-red-800';
  }
}

function showAuthorControls() {
  const container = document.getElementById('quiz-management-container').classList.remove('hidden');
  if (container) container.classList.remove('hidden');

  const btn = document.getElementById('start-quiz-btn');
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'Квиз начат';
    btn.classList.remove('bg-emerald-600');
    btn.classList.add('bg-green-600');
  }
}
</script>