<template id="answer-template">
  <div class="flex items-center gap-3 answer-item">
    <div class="flex-grow">
      <input type="text"
             name="quiz[questions_attributes][QUESTION_INDEX][answers_attributes][ANSWER_INDEX][answer_text]"
             class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500"
             required
             placeholder="Answer option...">
    </div>
    
    <div class="flex items-center">
      <input type="checkbox"
             name="quiz[questions_attributes][QUESTION_INDEX][answers_attributes][ANSWER_INDEX][is_correct]"
             value="1"
             class="h-5 w-5 text-emerald-600 border-gray-300 rounded">
      <label class="ml-2 text-sm text-gray-700">Is correct</label>
    </div>
    
    <button type="button" 
            onclick="removeAnswer(this)"
            class="text-red-600 hover:text-red-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</template>