<h1>Личный кабинет</h1>

<h2>Информация о профиле</h2>
  
<div style="margin-bottom: 15px;">
  <strong>Имя пользователя:</strong> <%= @user.nickname %>
</div>
  
<div style="margin-bottom: 15px;">
  <strong>Email:</strong> <%= @user.email %>
</div>
  
<div style="margin-bottom: 15px;">
  <strong>Дата регистрации:</strong> <%= @user.created_at.strftime("%d.%m.%Y %H:%M") %>
</div>
  
<div style="margin-bottom: 15px;">
  <strong>Последнее обновление:</strong> <%= @user.updated_at.strftime("%d.%m.%Y %H:%M") %>
</div>

