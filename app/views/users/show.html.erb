<div>
  <h1 style="margin-bottom: 1.5rem;">Личный кабинет</h1>
  
  <div style="max-width: 600px;">    
    <div>
      <label>Имя пользователя</label>
      <div style="padding: 0.8rem; background: #DCDCDC;">
        <%= @user.nickname %>
      </div>
    </div>
    
    <div>
      <label>Почта</label>
      <div style="padding: 0.8rem; background: #DCDCDC;">
        <%= @user.email %>
      </div>
    </div>
    
    <div>
      <label>Дата регистрации</label>
      <div style="padding: 0.8rem; background: #DCDCDC;">
        <%= @user.created_at.strftime("%d.%m.%Y; %H:%M") %>
      </div>
    </div>
    
    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <%= link_to "Мои квизы", my_quizzes_path, class: "btn" %>
      <%= link_to "Редактировать профиль", edit_profile_path, class: "btn" %>
      <%= link_to "Сменить пароль", change_password_profile_path, class: "btn btn-outline" %>
    </div>
  </div>
</div>