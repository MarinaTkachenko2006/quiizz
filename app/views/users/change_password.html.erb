<div style="max-width: 500px; margin: 0 auto;">
  <h1 style="margin-bottom: 1.5rem; color: #333;">Смена пароля</h1>
  
  <%= form_with url: update_password_profile_path, method: :patch do |form| %>
    <% if flash[:alert] %>
      <%= flash[:alert] %>
    <% end %>

    <div style="margin-bottom: 1.5rem;">
      <%= form.label :current_password, "Текущий пароль" %>
      <%= form.password_field :current_password, required: true %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= form.label :new_password, "Новый пароль" %>
      <%= form.password_field :new_password, required: true %>
      <small style="color: #777; display: block; margin-top: 0.5rem;">Минимум 8 символов</small>
    </div>

    <div style="margin-bottom: 2rem;">
      <%= form.label :password_confirmation, "Подтверждение пароля" %>
      <%= form.password_field :password_confirmation, required: true %>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <%= form.submit "Изменить пароль", class: "btn" %>
      <%= link_to "Отмена", profile_path, class: "btn btn-outline" %>
    </div>
  <% end %>
</div>