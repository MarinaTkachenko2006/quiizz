<h1>Смена пароля</h1>

<%= form_with url: update_password_profile_path, method: :patch do |form| %>
  <% if flash[:alert] %>
    <div style="color: red; margin-bottom: 15px;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= form.label :current_password, "Текущий пароль" %>
    <%= form.password_field :current_password, required: true %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :new_password, "Новый пароль (минимум 8 символов)" %>
    <%= form.password_field :new_password, required: true %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :password_confirmation, "Подтверждение нового пароля" %>
    <%= form.password_field :password_confirmation, required: true %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.submit "Изменить пароль" %>
    <%= link_to "Отмена", profile_path, style: "margin-left: 10px;" %>
  </div>
<% end %>

<p><%= link_to "Назад в личный кабинет", profile_path %></p>